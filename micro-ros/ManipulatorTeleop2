#include <Arduino.h>
#include <ESP32Encoder.h>

#include <micro_ros_platformio.h>
#include <rcl/rcl.h>
#include <rclc/rclc.h>
#include <rclc/executor.h>
#include <std_msgs/msg/int32.h>
#include <std_msgs/msg/string.h>

// ================= PIN DEFINITIONS =================
#define MOTOR_PWM_BASE 16
#define MOTOR_DIR_BASE 4
#define ENCODER_BASE_A 33
#define ENCODER_BASE_B 32

#define MOTOR_PWM_L1 19
#define MOTOR_DIR_L1 18
#define ENCODER_L1_A 35
#define ENCODER_L1_B 34

#define MOTOR_PWM_L2 22
#define MOTOR_DIR_L2 21
#define ENCODER_L2_A 39
#define ENCODER_L2_B 36

// ================= ENCODER CPR =================
#define CPR_BASE 120000.0
#define CPR_L1 37500.0
#define CPR_L2 120000.0

// ================= MOTOR PARAMETERS =================
const int pwmFreq = 20000;
const int pwmRes = 8;
const int chBase = 0, chL1 = 1, chL2 = 2;
const int fixedPWM = 100;
const float angleTolerance = 1.0;
const float stepAngle = 3.0; // degrees per command step

// ================= ENCODERS =================
ESP32Encoder encBase, encL1, encL2;

// ================= CONTROL VARIABLES =================
float targetBase = 0, targetL1 = 0, targetL2 = 0;
bool activeBase = false, activeL1 = false, activeL2 = false;

// ================= micro-ROS ENTITIES =================
rcl_node_t node;
rclc_executor_t executor;
rcl_allocator_t allocator;
rclc_support_t support;
rcl_subscription_t manipulator_cmd_sub;
rcl_publisher_t debug_pub;

std_msgs__msg__Int32 manipulator_cmd_msg;
std_msgs__msg__String debug_msg;

// ================= UTILITY =================
#define RCCHECK(fn)       \
  {                       \
    rcl_ret_t rc = fn;    \
    if (rc != RCL_RET_OK) \
    {                     \
      while (1);          \
    }                     \
  }
              

void debug_log(const char *msg)
{
debug_msg.data.data = (char *)msg;
debug_msg.data.size = strlen(msg);
debug_msg.data.capacity = debug_msg.data.size + 1;
rcl_publish(&debug_pub, &debug_msg, NULL);
//Serial.println(msg);
}

float getAngle(long count, float cpr)
{
return (count / cpr) * 360.0;
}

void motorDrive(int channel, int dirPin, int pwm)
{
bool dir = pwm >= 0;
digitalWrite(dirPin, dir);
ledcWrite(channel, abs(pwm));
}

bool updateMotor(ESP32Encoder &enc, int channel, int dirPin,
float target, float cpr, const char *name)
{
  float angle = getAngle(enc.getCount(), cpr);
float error = target - angle;
bool done = fabs(error) <= angleTolerance;

if (!done)
{
int pwm = (error > 0) ? -fixedPWM : fixedPWM;
motorDrive(channel, dirPin, pwm);
}
else{
  motorDrive(channel,dirPin,0);
}

char buf[100];
snprintf(buf, sizeof(buf), "%s | Target: %.2f | Angle: %.2f | Err: %.2f", name, target, angle, error);
debug_log(buf);

return done;
}

// ================= COMMAND HANDLER =================
void handleCommand(char key)
{
switch (key)
{
case 'q':
targetBase += stepAngle;
activeBase = true;
debug_log("Base++");
break;
case 'a':
targetBase -= stepAngle;
activeBase = true;
debug_log("Base--");
break;
case 's':
targetL1 += stepAngle;
activeL1 = true;
debug_log("L1++");
break;
case 'w':
targetL1 -= stepAngle;
activeL1 = true;
debug_log("L1--");
break;
case 'e':
targetL2 += stepAngle;
activeL2 = true;
debug_log("L2++");
break;
case 'd':
targetL2 -= stepAngle;
activeL2 = true;
debug_log("L2--");
break;
case 'r':
targetBase = targetL1 = targetL2 = 0;
encBase.clearCount();
encL1.clearCount();
encL2.clearCount();
debug_log("Reset all joints");
break;
default:
debug_log("Invalid key pressed — ignored (motors unaffected)");
break;
}
}

// ================= ROS CALLBACK =================
void manipulator_cmd_callback(const void *msgin)
{
const std_msgs__msg__Int32 *msg = (const std_msgs__msg__Int32 *)msgin;
int cmd = msg->data;

switch (cmd)
{
case 1:
handleCommand('q');
break;
case 2:
handleCommand('a');
break;
case 3:
handleCommand('s');
break;
case 4:
handleCommand('w');
break;
case 5:
handleCommand('e');
break;
case 6:
handleCommand('d');
break;
case 7:
handleCommand('r');
break;
default:
debug_log("Invalid ROS command");
break;
}
}

// ================= SETUP =================
void setup()
{
Serial.begin(115200);
delay(2000);

ESP32Encoder::useInternalWeakPullResistors = puType::up;
encBase.attachHalfQuad(ENCODER_BASE_A, ENCODER_BASE_B);
encL1.attachHalfQuad(ENCODER_L1_A, ENCODER_L1_B);
encL2.attachHalfQuad(ENCODER_L2_A, ENCODER_L2_B);
encBase.clearCount();
encL1.clearCount();
encL2.clearCount();

pinMode(MOTOR_DIR_BASE, OUTPUT);
pinMode(MOTOR_DIR_L1, OUTPUT);
pinMode(MOTOR_DIR_L2, OUTPUT);

ledcSetup(chBase, pwmFreq, pwmRes);
ledcSetup(chL1, pwmFreq, pwmRes);
ledcSetup(chL2, pwmFreq, pwmRes);
ledcAttachPin(MOTOR_PWM_BASE, chBase);
ledcAttachPin(MOTOR_PWM_L1, chL1);
ledcAttachPin(MOTOR_PWM_L2, chL2);

// micro-ROS setup
set_microros_serial_transports(Serial);
allocator = rcl_get_default_allocator();
RCCHECK(rclc_support_init(&support, 0, NULL, &allocator));
RCCHECK(rclc_node_init_default(&node, "manipulator_node", "", &support));

RCCHECK(rclc_publisher_init_default(
&debug_pub, &node,
ROSIDL_GET_MSG_TYPE_SUPPORT(std_msgs, msg, String),
"manipulator_debug"));

RCCHECK(rclc_subscription_init_default(
&manipulator_cmd_sub, &node,
ROSIDL_GET_MSG_TYPE_SUPPORT(std_msgs, msg, Int32),
"manipulator_cmd"));

RCCHECK(rclc_executor_init(&executor, &support.context, 1, &allocator));
RCCHECK(rclc_executor_add_subscription(
&executor, &manipulator_cmd_sub, &manipulator_cmd_msg, &manipulator_cmd_callback, ON_NEW_DATA));

debug_log("Manipulator ready — control via ROS or Serial (q/a/w/s/e/d/r)");
}

// ================= LOOP =================
void loop()
{
// Check for local serial teleop

/* if (Serial.available())
{
char key = Serial.read();
handleCommand(key);
}
*/
// Spin ROS executor for remote teleop
rclc_executor_spin_some(&executor, RCL_MS_TO_NS(10));

// Update active motors
if (activeBase && updateMotor(encBase, chBase, MOTOR_DIR_BASE, targetBase, CPR_BASE, "Base"))
{
activeBase = false;
debug_log("Base reached target");
}

if (activeL1 && updateMotor(encL1, chL1, MOTOR_DIR_L1, targetL1, CPR_L1, "L1"))
{
activeL1 = false;
debug_log("L1 reached target");
}

if (activeL2 && updateMotor(encL2, chL2, MOTOR_DIR_L2, targetL2, CPR_L2, "L2"))
{
activeL2 = false;
debug_log("L2 reached target");
}

delay(50);
}
